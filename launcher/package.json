{
  "name": "liquidhome",
  "version": "0.1.0",
  "description": "LiquidHome — a macOS-style desktop shell / launcher for Windows 11.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --windowed",
    "shell": "electron . --shell",
    "smoke": "electron . --smoke",
    "pack": "electron-packager . LiquidHome --platform=win32 --arch=x64 --out=dist --overwrite --prune=true"
  },
  "author": "Cloudex Labs",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^43.2.0"
  }
}
